<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>SupermarketTrainer</AssemblyName>
    <RootNamespace>SupermarketTrainer</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>build\</OutputPath>
    <DebugType>none</DebugType>
    <!-- Overridable: dotnet build -p:GameDir="D:\SteamLibrary\steamapps\common\Supermarket Together" -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Supermarket Together</GameDir>
    <ManagedDir>$(GameDir)\Supermarket Together_Data\Managed</ManagedDir>
    <BepInExCore>$(MSBuildThisFileDirectory).tools\bepinex\pkg\BepInEx\core</BepInExCore>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove=".decomp\**;.tools\**;build\**" />
    <None Remove=".decomp\**;.tools\**;build\**" />
  </ItemGroup>

  <ItemDefinitionGroup>
    <Reference>
      <Private>false</Private>
    </Reference>
  </ItemDefinitionGroup>

  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(BepInExCore)\BepInEx.dll" />
    <Reference Include="0Harmony" HintPath="$(BepInExCore)\0Harmony.dll" />

    <Reference Include="Assembly-CSharp" HintPath="$(ManagedDir)\Assembly-CSharp.dll" />
    <Reference Include="Unity.StarterAssets" HintPath="$(ManagedDir)\Unity.StarterAssets.dll" />
    <Reference Include="Mirror" HintPath="$(ManagedDir)\Mirror.dll" />
    <Reference Include="PlayMaker" HintPath="$(ManagedDir)\PlayMaker.dll" />
    <Reference Include="Rewired_Core" HintPath="$(ManagedDir)\Rewired_Core.dll" />
    <Reference Include="Cinemachine" HintPath="$(ManagedDir)\Cinemachine.dll" />
    <Reference Include="UnityEngine" HintPath="$(ManagedDir)\UnityEngine.dll" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)\UnityEngine.CoreModule.dll" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(ManagedDir)\UnityEngine.IMGUIModule.dll" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(ManagedDir)\UnityEngine.InputLegacyModule.dll" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(ManagedDir)\UnityEngine.TextRenderingModule.dll" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(ManagedDir)\UnityEngine.PhysicsModule.dll" />
    <Reference Include="UnityEngine.AIModule" HintPath="$(ManagedDir)\UnityEngine.AIModule.dll" />
  </ItemGroup>

</Project>
